generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE_PRIVATE
  ACTIVE_MARKETPLACE
  SUSPENDED
  REJECTED
}

enum PriceType {
  FIXED
  STARTS_FROM
  CONSULTATION_REQUIRED
  FREE_CONSULTATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  REJECTED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  COMPLETED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REMOVED
}

enum ReviewSource {
  URGLOWUP
  GOOGLE
}

enum ExternalProvider {
  GOOGLE_BUSINESS_PROFILE
}

enum ExternalConnectionStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
  ERROR
}

enum ExternalSyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum ExternalReviewVisibility {
  VISIBLE
  HIDDEN_BY_SYSTEM
}

enum ExternalMediaVisibility {
  VISIBLE
  HIDDEN_BY_BUSINESS
  HIDDEN_BY_SYSTEM
}

enum MediaType {
  COVER
  LOGO
  PORTFOLIO_IMAGE
  PORTFOLIO_VIDEO
  SERVICE_IMAGE
  BEFORE_AFTER
}

enum MediaStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum PostStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum PostContentType {
  REAL_WORK
  INSPIRATION
  EDUCATIONAL
  PROMOTION
}

enum PostMediaType {
  IMAGE
  VIDEO
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum NotificationLogType {
  TRANSACTIONAL
  MARKETING
}

enum ConsentCategory {
  PERSONALIZATION
  ANALYTICS
  MARKETING
}

enum ConsentAction {
  GRANTED
  REVOKED
}

enum CampaignStatus {
  DRAFT
  READY
  SENDING
  SENT
  PARTIAL_FAILURE
  FAILED
  ARCHIVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum HolidaySuggestionState {
  SUGGESTED
  APPLIED
  DISMISSED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

// ─── Models ──────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String   @default("")
  email          String   @unique
  emailVerified  Boolean  @default(false)
  firstName      String?
  lastName       String?
  phone          String?
  serviceAddress String?
  avatarUrl      String?
  role           UserRole @default(CUSTOMER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  suspendedAt    DateTime?
  suspendedUntil DateTime?
  suspensionReason String?

  twoFactorEnabled    Boolean          @default(false)

  business            Business?
  professional        Professional?
  accounts            Account[]
  appointments        Appointment[]
  reviews             Review[]
  favorites           Favorite[]
  adminActions        AdminAction[]
  externalConnections BusinessExternalConnection[]
  taggedPosts         Post[]                       @relation("TaggedPosts")
  postSaves           PostSave[]
  preferences         UserPreferences?
  consentAuditLogs    ConsentAuditLog[]
  notificationLogs    NotificationLog[]
  campaignRecipients  CampaignRecipient[]          @relation("CampaignRecipients")
  unsubscribeToken    UnsubscribeToken?            @relation("UnsubscribeTokens")
  createdCampaigns    Campaign[]
  sessions            Session[]
  twoFactor           TwoFactor?
  businessMemberships BusinessMember[]
  sentInvitations     BusinessInvitation[] @relation("SentInvitations")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(true)
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Business {
  id                   String         @id @default(cuid())
  ownerId              String         @unique
  owner                User           @relation(fields: [ownerId], references: [id])
  name                 String
  slug                 String         @unique
  description          String?
  phone                String?
  whatsapp             String?
  instagramUrl         String?
  address              String?
  city                 String?
  district             String?
  latitude             Float?
  longitude            Float?
  geocodedAt           DateTime?
  geocodingStatus      String?
  geocodingError       String?
  coverImageUrl        String?
  logoUrl              String?
  status               BusinessStatus @default(DRAFT)
  isMarketplaceVisible Boolean        @default(false)
  googlePlaceId        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  categories          BusinessToCategory[]
  services            BusinessService[]
  hours               BusinessHour[]
  media               BusinessMedia[]
  appointments        Appointment[]
  reviews             Review[]
  favorites           Favorite[]
  externalConnections BusinessExternalConnection[]
  externalReviewCache ExternalReviewCache[]
  externalMediaCache  ExternalMediaCache[]
  ratingStats         BusinessRatingStats?
  posts               Post[]
  professionals       Professional[]
  holidaySuggestions  BusinessHolidaySuggestion[]
  members             BusinessMember[]
  invitations         BusinessInvitation[]
  blockedTimes        BlockedTime[]

  @@index([city])
  @@index([status])
}

model BusinessCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses BusinessToCategory[]
  posts      Post[]
  styleTags  StyleTag[]
}

model BusinessToCategory {
  businessId String
  categoryId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

model BusinessService {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  slug            String    @unique
  description     String?
  durationMinutes Int
  price           Decimal?  @db.Decimal(10, 2)
  priceType       PriceType @default(FIXED)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments Appointment[]
  media        BusinessMedia[]
  posts        Post[]
  professionals ProfessionalService[]
}

model BusinessHour {
  id                  String    @id @default(cuid())
  businessId          String
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek           DayOfWeek
  isOpen              Boolean   @default(true)
  openTime            String?
  closeTime           String?
  slotIntervalMinutes Int       @default(30)
  appointmentBufferMinutes Int   @default(0)
  workBlocks          Json?
  breakBlocks         Json?
  staffNotes          String?
  exceptionNotes      String?

  @@unique([businessId, dayOfWeek])
}

model PublicHoliday {
  id      String   @id @default(cuid())
  country String   @default("TR")
  date    DateTime @db.Date
  name    String
  year    Int

  suggestions BusinessHolidaySuggestion[]

  @@unique([country, date])
  @@index([country, year])
}

model BusinessHolidaySuggestion {
  id         String                 @id @default(cuid())
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  holidayId  String
  holiday    PublicHoliday          @relation(fields: [holidayId], references: [id])
  state      HolidaySuggestionState @default(SUGGESTED)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([businessId, holidayId])
  @@index([businessId, state])
}

model BusinessMedia {
  id               String           @id @default(cuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  type             MediaType
  title            String?
  description      String?
  relatedServiceId String?
  relatedService   BusinessService? @relation(fields: [relatedServiceId], references: [id], onDelete: SetNull)
  cropX            Int?
  cropY            Int?
  cropWidth        Int?
  cropHeight       Int?
  originalWidth    Int?
  originalHeight   Int?
  status           MediaStatus      @default(ACTIVE)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id])
  customerId    String
  customer      User              @relation(fields: [customerId], references: [id])
  serviceId     String
  service       BusinessService   @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional  Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  requestedDate DateTime          @db.Date
  requestedTime String
  status          AppointmentStatus @default(PENDING)
  customerNote    String?
  businessNote    String?
  cancelledReason String?
  createdAt       DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  review           Review?
  notificationLogs NotificationLog[]

  @@index([businessId, status])
  @@index([customerId])
}

model BlockedTime {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  date           DateTime      @db.Date
  startTime      String
  endTime        String
  reason         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, date])
  @@index([professionalId, date])
}

model NotificationLog {
  id                 String              @id @default(cuid())
  appointmentId      String?
  appointment        Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientUserId    String?
  recipientUser      User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  notificationType   NotificationLogType @default(TRANSACTIONAL)
  channel            NotificationChannel
  recipientPhone     String
  templateName       String
  status             NotificationStatus
  providerMessageId  String?
  errorMessage       String?
  createdAt          DateTime            @default(now())
  sentAt             DateTime?

  @@unique([appointmentId, channel, templateName])
  @@index([recipientUserId])
}

model Review {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id])
  customerId    String
  customer      User         @relation(fields: [customerId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Float
  trustWeight   Float        @default(1.0)
  comment       String?
  status        ReviewStatus @default(PENDING)
  source        ReviewSource @default(URGLOWUP)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BusinessRatingStats {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawAverage           Float?
  rawReviewCount       Int      @default(0)
  weightedAverage      Float?
  effectiveReviewCount Float    @default(0)
  bayesianScore        Float?
  recentReviewCount    Int      @default(0)
  lastCalculatedAt     DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())
}

model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("TR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── External Source Cache (Google Business Profile) ─────────────────────────
// Architecture rules enforced at the data layer:
//   1. Google reviews NEVER write to the native Review table.
//   2. Google photos NEVER write to BusinessMedia or Cloudinary.
//   3. Google rating and UrGlowUp rating are NEVER merged.
//   4. Google content is NEVER used for AI training, marketplace ranking,
//      or the native media library.
//   5. Google attribution/source labels must always be preserved.

model BusinessExternalConnection {
  id                    String                   @id @default(cuid())
  businessId            String
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider              ExternalProvider
  // Google account / location identifiers
  providerAccountId     String
  providerAccountName   String?
  providerLocationId    String?
  providerLocationName  String?
  placeId               String?
  // Who connected this account
  connectedByUserId     String
  connectedBy           User                     @relation(fields: [connectedByUserId], references: [id])
  // OAuth scopes granted (stored as array)
  scopes                String[]
  // Encrypted OAuth tokens — AES-256-GCM, stored as iv:authTag:ciphertext (hex)
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  // Explicit connection lifecycle status (not a boolean flag)
  status                ExternalConnectionStatus @default(ACTIVE)
  disconnectedAt        DateTime?
  // Sync job state (separate from connection status)
  syncStatus            ExternalSyncStatus       @default(IDLE)
  lastSyncAt            DateTime?
  nextSyncAt            DateTime?
  lastError             String?
  // Business-controlled display toggles (section-level, not per-item)
  showExternalReviews   Boolean                  @default(true)
  showExternalPhotos    Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  reviewCache ExternalReviewCache[]
  mediaCache  ExternalMediaCache[]

  @@unique([businessId, provider])
  @@index([businessId])
  @@index([status])
  @@index([provider, syncStatus])
}

model ExternalReviewCache {
  id                      String                     @id @default(cuid())
  businessId              String
  business                Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId            String
  connection              BusinessExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider                ExternalProvider
  // Google review identifier
  providerReviewId        String
  // Review content
  rating                  Int
  comment                 String?
  reviewerDisplayName     String
  reviewerProfilePhotoUrl String?
  createTime              DateTime?
  updateTime              DateTime?
  merchantReply           String?
  mediaItemsJson          String? // JSON array of media items from Google (read-only reference)
  // Attribution / source — must always be preserved
  attribution             String? // e.g. "Google"
  sourceUrl               String? // Direct link to the review on Google Maps
  // Cache lifecycle
  fetchedAt               DateTime
  expiresAt               DateTime // fetchedAt + 30 days
  // Display control — HIDDEN_BY_BUSINESS is intentionally absent:
  // businesses control visibility at the section level via showExternalReviews,
  // not by cherry-picking individual reviews.
  visibilityStatus        ExternalReviewVisibility   @default(VISIBLE)
  displayOrder            Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@unique([businessId, provider, providerReviewId])
  @@index([businessId, provider])
  @@index([expiresAt])
  @@index([businessId, visibilityStatus])
}

// ─── Visual Posts ────────────────────────────────────────────────

model Post {
  id                  String            @id @default(cuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  description         String?
  relatedServiceId    String?
  relatedService      BusinessService?  @relation(fields: [relatedServiceId], references: [id], onDelete: SetNull)
  professionalId      String?
  professional        Professional?     @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  taggedUserId        String?
  taggedUser          User?             @relation("TaggedPosts", fields: [taggedUserId], references: [id], onDelete: SetNull)
  tagApproved         Boolean           @default(false)
  tagVisible          Boolean           @default(false)
  status              PostStatus        @default(ACTIVE)
  contentType         PostContentType   @default(REAL_WORK)
  externalPublishMeta Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  media     PostMedia[]
  saves     PostSave[]
  styleTags PostStyleTag[]

  @@index([businessId, status])
  @@index([categoryId, status])
  @@index([contentType, status])
  @@index([professionalId, status])
  @@index([createdAt(sort: Desc)])
}

model PostMedia {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  type      PostMediaType
  sortOrder Int           @default(0)
  width     Int?
  height    Int?
  duration  Float?
  createdAt DateTime      @default(now())

  @@index([postId, sortOrder])
}

model PostSave {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
}

// ─── Style Tags ──────────────────────────────────────────────────

model StyleTag {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  categoryId  String?
  category    BusinessCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  posts PostStyleTag[]

  @@index([categoryId, isActive])
  @@index([isActive, sortOrder])
}

model PostStyleTag {
  postId     String
  styleTagId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  styleTag   StyleTag @relation(fields: [styleTagId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([postId, styleTagId])
  @@index([styleTagId])
}

// ─── Professionals ───────────────────────────────────────────────
// v1 scope: a Professional always belongs to a Business (no standalone
// solo professionals yet). userId is reserved for future self-managed
// account linking — no separate professional auth/dashboard exists.

model Professional {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  slug          String   @unique
  displayName   String
  title         String?
  bio           String?
  avatarUrl     String?
  coverImageUrl String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services     ProfessionalService[]
  posts        Post[]
  appointments Appointment[]
  blockedTimes BlockedTime[]

  @@index([businessId, isActive])
}

model ProfessionalService {
  professionalId String
  professional   Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  serviceId      String
  service        BusinessService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assignedAt     DateTime        @default(now())

  @@id([professionalId, serviceId])
  @@index([serviceId])
}

// ─── User Preferences & Consent ─────────────────────────────────

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Locale — null means fall back to NEXT_LOCALE cookie / Accept-Language
  locale String?

  // Theme — SYSTEM defers to prefers-color-scheme
  theme  Theme  @default(SYSTEM)

  // Consent timestamps — null means not yet consented; kept on revocation for audit
  personalizationConsentAt DateTime?
  personalizationRevokedAt DateTime?
  analyticsConsentAt       DateTime?
  analyticsRevokedAt       DateTime?
  marketingConsentAt       DateTime?
  marketingRevokedAt       DateTime?
  // Bump this string when privacy policy changes to trigger re-consent
  consentVersion           String?

  // Notification preferences
  emailTransactional    Boolean @default(true)
  whatsappTransactional Boolean @default(true)
  emailMarketing        Boolean @default(false)
  whatsappMarketing     Boolean @default(false)

  // Affinity cache — JSON arrays of categoryId / styleTagId strings, ordered by score
  // null = not yet computed or consent not given
  preferredCategoryIds Json?
  preferredStyleTagIds Json?
  affinityComputedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConsentAuditLog {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  ConsentCategory
  action    ConsentAction
  version   String
  ipHash    String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([userId, category])
  @@index([createdAt])
}

// ─── Campaign & Marketing ────────────────────────────────────────────────────

model Campaign {
  id               String         @id @default(cuid())
  name             String
  channel          NotificationChannel
  status           CampaignStatus @default(DRAFT)
  audienceFilters  Json           // snapshot of segmentation params
  recipientCount   Int?           // set at snapshot time
  subject          String?        // email only
  templateName     String?        // whatsapp only
  templateParams   Json?          // whatsapp parameter values
  contentJson      Json?          // email body / React template config
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  sentAt           DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model CampaignRecipient {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(name: "CampaignRecipients", fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail    String?
  recipientPhone    String?
  status            NotificationStatus // PENDING|SENT|FAILED|SKIPPED
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  sentAt            DateTime?

  @@unique([campaignId, userId])
  @@index([campaignId, status])
  @@index([userId])
}

model UnsubscribeToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(name: "UnsubscribeTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

// ─── External Source Cache (Google Business Profile) ─────────────────────────

model ExternalMediaCache {
  id                   String                     @id @default(cuid())
  businessId           String
  business             Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId         String
  connection           BusinessExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider             ExternalProvider
  // Google media identifier
  providerMediaId      String
  mediaFormat          String // "PHOTO" | "VIDEO" as returned by Google API
  category             String? // Google media category (EXTERIOR, INTERIOR, FOOD, etc.)
  // URLs — direct Google CDN only, NEVER Cloudinary
  sourceUrl            String // Full-size Google CDN URL
  thumbnailUrl         String? // Thumbnail URL from Google CDN
  // Attribution / source — must always be preserved
  attribution          String? // e.g. "Google"
  createTime           DateTime?
  // Cache lifecycle
  fetchedAt            DateTime
  expiresAt            DateTime // fetchedAt + 30 days
  // Display control — businesses may curate individual photos
  visibilityStatus     ExternalMediaVisibility    @default(VISIBLE)
  displayOrder         Int                        @default(0)
  isFeaturedByBusiness Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([businessId, provider, providerMediaId])
  @@index([businessId, provider])
  @@index([expiresAt])
  @@index([businessId, visibilityStatus])
}

// ─── Business Team ────────────────────────────────────────────────

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole
  invitedBy  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
}

model BusinessInvitation {
  id         String             @id @default(cuid())
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       BusinessMemberRole
  tokenHash  String             @unique
  invitedBy  String
  inviter    User               @relation("SentInvitations", fields: [invitedBy], references: [id])
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime           @default(now())

  @@unique([businessId, email])
  @@index([tokenHash])
  @@index([businessId])
}
