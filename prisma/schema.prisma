generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN
}

enum BusinessStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE_PRIVATE
  ACTIVE_MARKETPLACE
  SUSPENDED
  REJECTED
}

enum PriceType {
  FIXED
  STARTS_FROM
  CONSULTATION_REQUIRED
  FREE_CONSULTATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_BUSINESS
  COMPLETED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
  REMOVED
}

enum ReviewSource {
  URGLOWUP
  GOOGLE
}

enum ExternalProvider {
  GOOGLE_BUSINESS_PROFILE
}

enum ExternalConnectionStatus {
  ACTIVE
  EXPIRED
  DISCONNECTED
  ERROR
}

enum ExternalSyncStatus {
  IDLE
  SYNCING
  ERROR
}

enum ExternalReviewVisibility {
  VISIBLE
  HIDDEN_BY_SYSTEM
}

enum ExternalMediaVisibility {
  VISIBLE
  HIDDEN_BY_BUSINESS
  HIDDEN_BY_SYSTEM
}

enum MediaType {
  COVER
  LOGO
  PORTFOLIO_IMAGE
  PORTFOLIO_VIDEO
  SERVICE_IMAGE
  BEFORE_AFTER
}

enum MediaStatus {
  ACTIVE
  HIDDEN
  REMOVED
}

enum NotificationChannel {
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─── Models ──────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  avatarUrl String?
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business            Business?
  appointments        Appointment[]
  reviews             Review[]
  favorites           Favorite[]
  adminActions        AdminAction[]
  externalConnections BusinessExternalConnection[]
}

model Business {
  id                   String         @id @default(cuid())
  ownerId              String         @unique
  owner                User           @relation(fields: [ownerId], references: [id])
  name                 String
  slug                 String         @unique
  description          String?
  phone                String?
  whatsapp             String?
  instagramUrl         String?
  address              String?
  city                 String?
  district             String?
  latitude             Float?
  longitude            Float?
  geocodedAt           DateTime?
  geocodingStatus      String?
  geocodingError       String?
  coverImageUrl        String?
  logoUrl              String?
  status               BusinessStatus @default(DRAFT)
  isMarketplaceVisible Boolean        @default(false)
  googlePlaceId        String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  categories          BusinessToCategory[]
  services            BusinessService[]
  hours               BusinessHour[]
  media               BusinessMedia[]
  appointments        Appointment[]
  reviews             Review[]
  favorites           Favorite[]
  externalConnections BusinessExternalConnection[]
  externalReviewCache ExternalReviewCache[]
  externalMediaCache  ExternalMediaCache[]
  ratingStats         BusinessRatingStats?

  @@index([city])
  @@index([status])
}

model BusinessCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businesses BusinessToCategory[]
}

model BusinessToCategory {
  businessId String
  categoryId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([businessId, categoryId])
}

model BusinessService {
  id              String    @id @default(cuid())
  businessId      String
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  durationMinutes Int
  price           Decimal?  @db.Decimal(10, 2)
  priceType       PriceType @default(FIXED)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  appointments Appointment[]
  media        BusinessMedia[]
}

model BusinessHour {
  id                  String    @id @default(cuid())
  businessId          String
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  dayOfWeek           DayOfWeek
  isOpen              Boolean   @default(true)
  openTime            String?
  closeTime           String?
  slotIntervalMinutes Int       @default(30)

  @@unique([businessId, dayOfWeek])
}

model BusinessMedia {
  id               String           @id @default(cuid())
  businessId       String
  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  type             MediaType
  title            String?
  description      String?
  relatedServiceId String?
  relatedService   BusinessService? @relation(fields: [relatedServiceId], references: [id], onDelete: SetNull)
  status           MediaStatus      @default(ACTIVE)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Appointment {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id])
  customerId    String
  customer      User              @relation(fields: [customerId], references: [id])
  serviceId     String
  service       BusinessService   @relation(fields: [serviceId], references: [id])
  requestedDate DateTime          @db.Date
  requestedTime String
  status        AppointmentStatus @default(PENDING)
  customerNote  String?
  businessNote  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  review           Review?
  notificationLogs NotificationLog[]

  @@index([businessId, status])
  @@index([customerId])
}

model NotificationLog {
  id                String              @id @default(cuid())
  appointmentId     String
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  recipientPhone    String
  templateName      String
  status            NotificationStatus
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@unique([appointmentId, channel, templateName])
}

model Review {
  id            String       @id @default(cuid())
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id])
  customerId    String
  customer      User         @relation(fields: [customerId], references: [id])
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  rating        Float
  trustWeight   Float        @default(1.0)
  comment       String?
  status        ReviewStatus @default(PENDING)
  source        ReviewSource @default(URGLOWUP)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model BusinessRatingStats {
  id                   String   @id @default(cuid())
  businessId           String   @unique
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rawAverage           Float?
  rawReviewCount       Int      @default(0)
  weightedAverage      Float?
  effectiveReviewCount Float    @default(0)
  bayesianScore        Float?
  recentReviewCount    Int      @default(0)
  lastCalculatedAt     DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())
}

model Region {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String   @default("TR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── External Source Cache (Google Business Profile) ─────────────────────────
// Architecture rules enforced at the data layer:
//   1. Google reviews NEVER write to the native Review table.
//   2. Google photos NEVER write to BusinessMedia or Cloudinary.
//   3. Google rating and UrGlowUp rating are NEVER merged.
//   4. Google content is NEVER used for AI training, marketplace ranking,
//      or the native media library.
//   5. Google attribution/source labels must always be preserved.

model BusinessExternalConnection {
  id                    String                   @id @default(cuid())
  businessId            String
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider              ExternalProvider
  // Google account / location identifiers
  providerAccountId     String
  providerAccountName   String?
  providerLocationId    String?
  providerLocationName  String?
  placeId               String?
  // Who connected this account
  connectedByUserId     String
  connectedBy           User                     @relation(fields: [connectedByUserId], references: [id])
  // OAuth scopes granted (stored as array)
  scopes                String[]
  // Encrypted OAuth tokens — AES-256-GCM, stored as iv:authTag:ciphertext (hex)
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  // Explicit connection lifecycle status (not a boolean flag)
  status                ExternalConnectionStatus @default(ACTIVE)
  disconnectedAt        DateTime?
  // Sync job state (separate from connection status)
  syncStatus            ExternalSyncStatus       @default(IDLE)
  lastSyncAt            DateTime?
  nextSyncAt            DateTime?
  lastError             String?
  // Business-controlled display toggles (section-level, not per-item)
  showExternalReviews   Boolean                  @default(true)
  showExternalPhotos    Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  reviewCache ExternalReviewCache[]
  mediaCache  ExternalMediaCache[]

  @@unique([businessId, provider])
  @@index([businessId])
  @@index([status])
  @@index([provider, syncStatus])
}

model ExternalReviewCache {
  id                      String                   @id @default(cuid())
  businessId              String
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId            String
  connection              BusinessExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider                ExternalProvider
  // Google review identifier
  providerReviewId        String
  // Review content
  rating                  Int
  comment                 String?
  reviewerDisplayName     String
  reviewerProfilePhotoUrl String?
  createTime              DateTime?
  updateTime              DateTime?
  merchantReply           String?
  mediaItemsJson          String?                  // JSON array of media items from Google (read-only reference)
  // Attribution / source — must always be preserved
  attribution             String?                  // e.g. "Google"
  sourceUrl               String?                  // Direct link to the review on Google Maps
  // Cache lifecycle
  fetchedAt               DateTime
  expiresAt               DateTime                 // fetchedAt + 30 days
  // Display control — HIDDEN_BY_BUSINESS is intentionally absent:
  // businesses control visibility at the section level via showExternalReviews,
  // not by cherry-picking individual reviews.
  visibilityStatus        ExternalReviewVisibility @default(VISIBLE)
  displayOrder            Int                      @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([businessId, provider, providerReviewId])
  @@index([businessId, provider])
  @@index([expiresAt])
  @@index([businessId, visibilityStatus])
}

model ExternalMediaCache {
  id                   String                  @id @default(cuid())
  businessId           String
  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId         String
  connection           BusinessExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider             ExternalProvider
  // Google media identifier
  providerMediaId      String
  mediaFormat          String                  // "PHOTO" | "VIDEO" as returned by Google API
  category             String?                 // Google media category (EXTERIOR, INTERIOR, FOOD, etc.)
  // URLs — direct Google CDN only, NEVER Cloudinary
  sourceUrl            String                  // Full-size Google CDN URL
  thumbnailUrl         String?                 // Thumbnail URL from Google CDN
  // Attribution / source — must always be preserved
  attribution          String?                 // e.g. "Google"
  createTime           DateTime?
  // Cache lifecycle
  fetchedAt            DateTime
  expiresAt            DateTime                // fetchedAt + 30 days
  // Display control — businesses may curate individual photos
  visibilityStatus     ExternalMediaVisibility @default(VISIBLE)
  displayOrder         Int                     @default(0)
  isFeaturedByBusiness Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([businessId, provider, providerMediaId])
  @@index([businessId, provider])
  @@index([expiresAt])
  @@index([businessId, visibilityStatus])
}
